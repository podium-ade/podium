<?xml version="1.0" encoding="UTF-8"?>
<!--
  LibreOffice system-wide defaults for the sample desktop, so Calc opens straight to the sheet for
  whoever drives it, agent or person: no tip-of-the-day dialog, no first-run tour, and no "running
  this version for the first time" bar. A user's own settings still win; these only change what a
  fresh profile starts with.

  @LO_VERSION@ is the installed major.minor (25.2 on trixie), which the Dockerfile writes in at
  build time: the bar compares it with the running version, so a literal would bring the bar back
  with the next LibreOffice upgrade.
-->
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:oor="http://openoffice.org/2001/registry">
  <dependency file="main"/>
  <oor:component-data oor:name="Common" oor:package="org.openoffice.Office">
    <node oor:name="Misc">
      <prop oor:name="ShowTipOfTheDay" oor:op="fuse">
        <value>false</value>
      </prop>
      <prop oor:name="FirstRun" oor:op="fuse">
        <value>false</value>
      </prop>
    </node>
  </oor:component-data>
  <oor:component-data oor:name="Setup" oor:package="org.openoffice">
    <node oor:name="Product">
      <prop oor:name="ooSetupLastVersion" oor:op="fuse">
        <value>@LO_VERSION@</value>
      </prop>
    </node>
  </oor:component-data>
</oor:data>
