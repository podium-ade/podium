# Podium — every environment variable the binaries read, plus the ones the compose files
# interpolate. Copy to .env and fill in what you need, or run `podium-server init`, which
# writes a .env with fresh credentials already in it.
#
# This file is checked by a test: `go test ./deploy/...` fails if the source reads a
# PODIUM_* variable that is not listed here, or if this file documents one that no longer
# exists. Every line below is either a real variable or a real omission.
#
# Values shown after `=` are the defaults. A commented-out line means "this is the default,
# uncomment to change it". A line with no value that is NOT commented out is required.

# =============================================================================
# podium-server — the control plane
# =============================================================================

# REQUIRED. The Postgres DSN. The server migrates the schema on start.
# The compose files build this from PODIUM_PG_PASSWORD; set it directly when you run the
# binary by hand.
PODIUM_DATABASE_URL=

# How clients and nodes reach the server.
#   dev      loopback HTTP with a shared bearer token. One machine. The tested path.
#   tailnet  the server embeds its own Tailscale device (tsnet) and serves HTTPS on its
#            MagicDNS name. Workers can be anywhere.
#   host     like tailnet, but over the machine's existing tailscaled. Unverified.
#PODIUM_TRANSPORT=dev

# dev transport only. Must resolve to loopback or the server refuses to start — the dev
# token is the only credential there is, so it may not be exposed off the machine.
#PODIUM_DEV_LISTEN=127.0.0.1:8080

# REQUIRED for PODIUM_TRANSPORT=dev. The shared bearer token every API call and the web UI
# present. There is no per-user identity under this transport and no RBAC anywhere: whoever
# holds this token can do everything.
PODIUM_DEV_TOKEN=

# The file holding the 32-byte AES-256 key every stored secret is encrypted under.
# Mode 0600 or 0400 — the server refuses to start on anything a group or other can read.
# Generate one with `podium-server gen-master-key --out master.key`.
# Leaving it unset is a supported configuration: the server starts, and every secret
# operation answers FailedPrecondition. Podium is still a task runner without secrets.
# THERE IS NO RECOVERY PATH. Back this file up somewhere that is not the control plane.
#PODIUM_MASTER_KEY_FILE=/etc/podium/master.key

# The same key inline, hex encoded. Development only: an environment variable is visible in
# /proc and in `docker inspect`. The server warns loudly when it is used, and the file wins
# if both are set.
#PODIUM_MASTER_KEY=

# --- Tailscale (PODIUM_TRANSPORT=tailnet or host) -----------------------------------------

# The Tailscale auth key, read on the FIRST RUN ONLY: after that PODIUM_TS_STATE_DIR is the
# device identity. Must be Reusable and Pre-approved and tagged tag:podium-server.
# This is Tailscale's key. It is NOT the Podium enrollment token below.
#TS_AUTHKEY=

# The Tailscale device name, and therefore the first label of the MagicDNS name: the server
# ends up at https://<this>.<your-tailnet>.ts.net.
#PODIUM_TS_HOSTNAME=podium

# Where tsnet keeps the device's node key. MUST PERSIST across restarts, or the server
# registers a new Tailscale device every time and the MagicDNS name drifts to podium-1,
# podium-2, ... In compose this is a named volume.
#PODIUM_TS_STATE_DIR=/var/lib/podium/tsnet

# The ACL tag a Tailscale device must carry before the server will let it enroll as a node.
#PODIUM_TS_REQUIRED_NODE_TAG=tag:podium-node

# Let an UNTAGGED tailnet device enroll as a node. This removes the network-level proof that
# a caller is an authorised worker and exists only for a tailnet with no ACL tags yet. The
# server warns loudly at startup when it is on.
#PODIUM_TS_ALLOW_UNTAGGED_NODES=false

# --- Object store (artifacts and rolled-up logs) ------------------------------------------
# Leaving PODIUM_S3_ENDPOINT empty disables artifacts entirely, which is supported: a task
# does not need artifacts to run. Nodes never talk to the object store — an artifact travels
# node -> server -> S3 — so no worker ever holds these credentials.

# host:port, or a full URL. A URL's scheme decides TLS; a bare host:port is plain HTTP
# unless PODIUM_S3_USE_SSL says otherwise.
#PODIUM_S3_ENDPOINT=

# The bucket. Created on start if it is missing.
#PODIUM_S3_BUCKET=podium

#PODIUM_S3_ACCESS_KEY=
#PODIUM_S3_SECRET_KEY=

# MinIO ignores the region; a real S3 does not.
#PODIUM_S3_REGION=us-east-1

# Only consulted when PODIUM_S3_ENDPOINT is a bare host:port with no scheme.
#PODIUM_S3_USE_SSL=false

# --- Log roll-up ---------------------------------------------------------------------------
# A finished task's log chunks move out of Postgres into the object store and are pruned
# from the hot table a grace period later. With no object store configured nothing is rolled
# up and nothing is pruned: the chunks stay in Postgres forever.

# How often the roll-up sweep runs.
#PODIUM_LOG_ROLLUP_INTERVAL=1m

# How long after a task reaches a terminal status before its log is eligible. It exists so a
# straggling event batch is not left out of the archive.
#PODIUM_LOG_ROLLUP_SETTLE=30s

# How often rolled-up chunks are deleted from Postgres.
#PODIUM_LOG_PRUNE_INTERVAL=1h

# How long a rolled-up task's chunks survive in Postgres before the prune takes them. This
# is your "logs stay fast for N" knob. An unparseable value is ignored rather than treated
# as zero: a typo must not silently delete a day of retention.
#PODIUM_LOG_CHUNK_GRACE=24h

# =============================================================================
# podium-node — the worker daemon
# =============================================================================
# Every one of these can also live in /etc/podium/node.yaml (the key is the name below,
# lowercased, without the PODIUM_NODE_ prefix). The environment wins over the file.

# The control plane's base URL. http:// for the dev transport, https:// for tailnet/host —
# the daemon refuses a mismatch rather than failing later.
#PODIUM_NODE_SERVER=http://127.0.0.1:8080

#PODIUM_NODE_TRANSPORT=dev

# REQUIRED for PODIUM_NODE_TRANSPORT=dev: the server's PODIUM_DEV_TOKEN.
#PODIUM_NODE_DEV_TOKEN=

# Podium's own enrollment token, from `podium node enroll-token`. SINGLE USE, 1 hour default
# TTL, needed on the first run only — after that <data_dir>/identity.json is the identity.
# Not the same thing as TS_AUTHKEY.
#PODIUM_NODE_ENROLL_TOKEN=

# Holds identity.json (the node key, which the server returns exactly once and cannot
# reissue), each task's state, and the node's own tsnet state. Created if missing, and
# write-probed at startup. Put it on a fast local disk: it is where a task's workspace
# staging and secret files go.
#PODIUM_NODE_DATA_DIR=/var/lib/podium-node

# Comma separated. A task is only placed on a node whose labels are a superset of the
# task's, so these are how `--label linux/amd64` finds the right machine.
#PODIUM_NODE_LABELS=

# The concurrency budget the scheduler assigns against. 0 is refused, not silently accepted.
#PODIUM_NODE_MAX_TASKS=4

# /healthz, /readyz and /metrics. Loopback by default: none of it is authenticated.
#PODIUM_NODE_METRICS_LISTEN=127.0.0.1:9091

# Overrides the Docker engine endpoint. Empty means the usual DOCKER_HOST / docker context /
# default socket resolution. The data dir must be on the same host as the engine.
#PODIUM_NODE_DOCKER_HOST=

# The Tailscale auth key for this worker: reusable, pre-approved, tagged tag:podium-node.
# TS_AUTHKEY is honoured as a fallback; this prefixed name wins when both are set.
#PODIUM_NODE_TS_AUTHKEY=

# The worker's Tailscale device name. Empty derives it from the machine's hostname.
#PODIUM_NODE_TS_HOSTNAME=

# Turn on the LRU image-cache prune. OFF BY DEFAULT and deliberately so: a node shares its
# Docker engine with everything else on the machine. Even when it is on, Podium only ever
# removes an image it pulled itself — <data_dir>/images.json is the allow-list — and it
# never runs `docker system prune` or any bulk removal.
#PODIUM_NODE_IMAGE_CACHE_PRUNE=false

# The disk-usage fraction above which pruning starts. With pruning off, crossing it instead
# makes the node advertise free_slots=0: a machine that cannot fit another image cannot
# reliably start another task.
#PODIUM_NODE_IMAGE_CACHE_HIGH_WATERMARK=0.80

# Exit 0 once the control plane has drained this node and its last task has finished. This
# is the upgrade path: a supervisor restarts the process on the new binary. Without it a
# drained node stays connected and idle, which is what taking a machine out of service for
# maintenance wants.
#PODIUM_NODE_EXIT_ON_DRAIN=false

# =============================================================================
# podium-agent — the conductor
# =============================================================================
# A second long-lived process beside podium-server. It holds the bot's Slack identity, turns
# a mention into one Podium task running the agent runtime image, and relays what the agent
# says back into the thread. It is an ordinary API client of the control plane: it never
# opens the server's database, never sees the master key and never touches Docker.
# See docs/agent.md.

# REQUIRED. The Podium API base URL the conductor talks to. http:// for the dev transport,
# https://podium.<tailnet>.ts.net for a tailnet.
PODIUM_AGENT_SERVER=

# REQUIRED when PODIUM_AGENT_SERVER is http://: the server's PODIUM_DEV_TOKEN. A tailnet
# control plane needs none — Tailscale's WhoIs names the caller.
PODIUM_AGENT_API_TOKEN=

# REQUIRED. The conductor's OWN database, podium_agent, on the same Postgres as the
# server's. It is a different database, not a schema in the same one, and the conductor
# migrates it on start. deploy/postgres/init.sql creates it on a fresh volume; for an
# existing install:
#   docker compose exec -T postgres createdb -U podium podium_agent
PODIUM_AGENT_DATABASE_URL=

# The Connect API, /healthz, /readyz and /metrics. Loopback by default and it should stay
# that way: PODIUM_AGENT_TOKEN is the only credential, and podium-server is what a browser
# reaches the AgentService through.
#PODIUM_AGENT_LISTEN=127.0.0.1:8090

# REQUIRED. The bearer podium-server presents on proxied AgentService calls, and the only
# thing guarding every session the bot has had. As sensitive as PODIUM_DEV_TOKEN.
PODIUM_AGENT_TOKEN=

# Where profile.yaml, skills/ and prompts/ live. A skill file is the ONLY boundary around
# what a turn can do and which secrets it gets: keep `secrets:` minimal per skill.
#PODIUM_AGENT_PROFILE_DIR=/etc/podium/agent

# The Slack app-level token (xapp-…, scope connections:write) and bot token (xoxb-…). Both
# or neither: one alone is a startup error. Without them no Slack source is started and the
# conductor has nothing to listen to. As sensitive as any other credential here.
# deploy/slack-app-manifest.yaml is the app they come from.
#PODIUM_AGENT_SLACK_APP_TOKEN=
#PODIUM_AGENT_SLACK_BOT_TOKEN=

# TEST ONLY. Mounts an in-process source and two routes (POST /dev/inbound, GET
# /dev/outbound) that inject messages as if a human had sent them and report everything the
# bot says. The startup log shouts when it is on. Never set it outside a test.
#PODIUM_AGENT_DEV_SOURCE=false

# Where a provider key is validated before it is stored: GET <this>/v1/models with the
# pasted key. It is a test seam (the suite points it at a fake) and the hook for an egress
# proxy — it is NOT a BYOK knob. The provider is still Anthropic, and the conductor is the
# only thing that reads it: the model itself is called from inside a task container.
#PODIUM_AGENT_ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- the server-side half of the reverse proxy ---------------------------------------------
# These two are read by podium-server, not by the conductor, and they are what lets a browser
# reach the AgentService at all: the server forwards /podium.agent.v1.AgentService/ to
# PODIUM_AGENT_URL behind its own identity middleware, adding the bearer below and an
# X-Podium-Login header naming the operator (any client-supplied copy is stripped).

# Where the conductor listens, as podium-server reaches it: scheme://host:port with NO path.
# Unset means this control plane has no conductor — the prefix is not mounted, WhoAmI reports
# agent_enabled=false and the web UI hides its Agent screen. Setting it REQUIRES
# PODIUM_AGENT_TOKEN: a proxy that forwards an unauthenticated request into the conductor is
# worse than no proxy. In compose this is http://agent:8090.
#PODIUM_AGENT_URL=

# PODIUM_AGENT_TOKEN above is shared by both sides: podium-server presents it and the
# conductor requires it. Set it once.

# =============================================================================
# podium — the CLI
# =============================================================================
# Both are overridden by --server and --token, and both override
# ~/.config/podium/config.yaml.

#PODIUM_SERVER=http://127.0.0.1:8080

# The dev transport's bearer token. A tailnet control plane needs none: Tailscale's WhoIs
# names the caller, so `podium --server https://podium.<tailnet>.ts.net nodes` just works.
#PODIUM_TOKEN=

# =============================================================================
# Read by the compose files only — no Podium binary looks at these
# =============================================================================

# REQUIRED by docker-compose.yml and docker-compose.tailnet.yml. The Postgres password;
# the compose file builds PODIUM_DATABASE_URL from it.
PODIUM_PG_PASSWORD=

# Which released image tag the compose files pull for podium-server and podium-node. Pin it
# to a version you have tested: `latest` moves under you, and a control plane and its
# workers from different releases can disagree about the wire (`podium version` warns).
#PODIUM_IMAGE_TAG=latest

# Which host port docker-compose.yml publishes the server on, loopback only.
#PODIUM_PORT=8080

# Which host port docker-compose.yml publishes the MinIO console on, loopback only. The
# MinIO API port is deliberately not published.
#PODIUM_MINIO_CONSOLE_PORT=9001

# Which host port docker-compose.dev.yml publishes Postgres on, loopback only. Change it
# when something else already owns 5432, and match PODIUM_DATABASE_URL to it.
#PODIUM_PG_PORT=5432

# REQUIRED by docker-compose.tailnet.yml. Your tailnet's MagicDNS suffix WITHOUT .ts.net —
# `tailscale status --json` reports it as MagicDNSSuffix. The node service dials
# https://podium.<this>.ts.net.
#PODIUM_TAILNET=
