# podium-agent-runtime-browser — the base runtime plus Playwright and Chromium.
#
# Purpose: screenshots and browser verification for the coder skill (step 20).
#
# The Playwright base already carries Chromium, Firefox, WebKit and every system library
# they need, so `npx playwright install --with-deps` is already satisfied. Noble ships
# Node 22, which is what the runtime needs.
#
# The runtime layer is COPIED from podium-agent-runtime rather than rebuilt, so the two
# images can never drift: the same dist/ and the same node_modules run in both.
ARG RUNTIME_IMAGE=podium-agent-runtime:dev
ARG PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright:v1.62.1-noble@sha256:dcc5531e97840b9b5e794f2814476b21571c5124a3fca2267d73041f56e7580e

FROM ${RUNTIME_IMAGE} AS runtime

FROM ${PLAYWRIGHT_IMAGE}

ARG VERSION=dev
ARG REVISION=none
LABEL org.opencontainers.image.title="podium-agent-runtime-browser" \
      org.opencontainers.image.source="https://github.com/alvaroibarguen/podium" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}"

USER root

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl git jq ripgrep; \
    install -d -m 0755 /etc/apt/keyrings; \
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        -o /etc/apt/keyrings/githubcli-archive-keyring.gpg; \
    chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg; \
    printf 'deb [arch=%s signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main\n' \
        "$(dpkg --print-architecture)" > /etc/apt/sources.list.d/github-cli.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends gh; \
    rm -rf /var/lib/apt/lists/*; \
    git --version; gh --version; rg --version; jq --version; node --version

RUN set -eux; \
    existing="$(getent passwd 1000 | cut -d: -f1 || true)"; \
    if [ -z "$existing" ]; then \
        useradd --uid 1000 --create-home --shell /bin/bash agent; \
    elif [ "$existing" != agent ]; then \
        usermod --login agent --home /home/agent --move-home "$existing"; \
    fi; \
    install -d -o 1000 -g 1000 -m 0755 /workspace

COPY --from=runtime /opt/podium-agent /opt/podium-agent

RUN cd /opt/podium-agent && node -e "require('@anthropic-ai/claude-agent-sdk')"

ENV HOME=/home/agent \
    NODE_ENV=production

USER agent
WORKDIR /workspace
ENTRYPOINT ["node", "/opt/podium-agent/dist/main.js"]
