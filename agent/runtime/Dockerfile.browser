# podium-agent-runtime-browser — the base runtime plus Playwright and Chromium.
#
# Purpose: screenshots and browser verification for the coder skill (step 20).
#
# The Playwright base already carries Chromium, Firefox, WebKit and every system library
# they need, so `npx playwright install --with-deps` is already satisfied. It does NOT
# carry the npm package that drives them — only the browsers under /ms-playwright — so
# playwright-core is installed below, at the version that matches the base image's tag.
# Those two versions must agree: playwright-core looks for a browser build number it was
# compiled against, and a mismatch is a runtime error inside a scheduled task.
#
# The base image's Node is v24, not the v22 the other two images run. `engines.node: >=22`
# is satisfied either way; nothing here depends on the version matching.
#
# The runtime layer is COPIED from podium-agent-runtime rather than rebuilt, so the two
# images can never drift: the same dist/ and the same node_modules run in both.
ARG RUNTIME_IMAGE=podium-agent-runtime:dev
ARG PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright:v1.62.1-noble@sha256:dcc5531e97840b9b5e794f2814476b21571c5124a3fca2267d73041f56e7580e
ARG PLAYWRIGHT_VERSION=1.62.1

FROM ${RUNTIME_IMAGE} AS runtime

FROM ${PLAYWRIGHT_IMAGE}

ARG VERSION=dev
ARG REVISION=none
LABEL org.opencontainers.image.title="podium-agent-runtime-browser" \
      org.opencontainers.image.source="https://github.com/alvaroibarguen/podium" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}"

USER root

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl git jq ripgrep; \
    install -d -m 0755 /etc/apt/keyrings; \
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        -o /etc/apt/keyrings/githubcli-archive-keyring.gpg; \
    chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg; \
    printf 'deb [arch=%s signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main\n' \
        "$(dpkg --print-architecture)" > /etc/apt/sources.list.d/github-cli.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends gh; \
    rm -rf /var/lib/apt/lists/*; \
    git --version; gh --version; rg --version; jq --version; node --version

RUN set -eux; \
    existing="$(getent passwd 1000 | cut -d: -f1 || true)"; \
    if [ -z "$existing" ]; then \
        useradd --uid 1000 --create-home --shell /bin/bash agent; \
    elif [ "$existing" != agent ]; then \
        usermod --login agent --home /home/agent --move-home "$existing"; \
    fi; \
    install -d -o 1000 -g 1000 -m 0755 /workspace

COPY --from=runtime /opt/podium-agent /opt/podium-agent

RUN cd /opt/podium-agent && node -e "require('@anthropic-ai/claude-agent-sdk')"

# The screenshot helper and its own dependency tree. playwright-core goes in
# /opt/podium-agent/browser/node_modules rather than the runtime's, so the driver is
# resolvable from screenshot.mjs and from nothing else; the runtime's own node_modules is
# left exactly as the base image built it.
ARG PLAYWRIGHT_VERSION
RUN set -eux; \
    npm install --prefix /opt/podium-agent/browser --no-audit --no-fund \
        "playwright-core@${PLAYWRIGHT_VERSION}"; \
    npm cache clean --force
COPY browser/screenshot.mjs /opt/podium-agent/browser/screenshot.mjs
COPY browser/screenshot /opt/podium-agent/bin/screenshot

# Build-time assertions, like the SDK one above: a helper that cannot parse its own argv,
# or a driver that cannot find a browser, must fail here rather than inside a task that has
# already been scheduled.
RUN set -eux; \
    chmod 0755 /opt/podium-agent/bin/screenshot; \
    /opt/podium-agent/bin/screenshot 2>&1 | grep -q "^screenshot: usage:"; \
    cd /opt/podium-agent/browser; \
    node -e "const p = require('playwright-core').chromium.executablePath(); \
        if (!require('node:fs').existsSync(p)) { throw new Error('no chromium at ' + p); } \
        console.log('chromium: ' + p);"

ENV HOME=/home/agent \
    NODE_ENV=production

USER agent
WORKDIR /workspace
ENTRYPOINT ["node", "/opt/podium-agent/dist/main.js"]
