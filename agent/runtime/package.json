{
  "name": "podium-agent-runtime",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "One agent turn inside a Podium task container.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:images": "vitest run --config vitest.images.config.ts"
  },
  "dependencies": {
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
